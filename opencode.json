{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "grimnir",
  "model": "deepseek/deepseek-flash",
  "skills": [
    "./artemis/.claude/skills",
    "./huginn/.claude/skills",
    "./hunter/.claude/skills",
    "./specter/.claude/skills",
    "./nimbus/.claude/skills",
    "./nomad/.claude/skills"
  ],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "skill": "allow",
    "subagent": "allow",
    "execute": "deny",
    "bash": {
      "*": "ask",
      "curl *": "allow",
      "python3 *": "allow",
      "httpx *": "allow",
      "nuclei *": "allow",
      "jq *": "allow",
      "gron *": "allow",
      "ffuf *": "allow",
      "katana *": "allow",
      "kr *": "allow",
      "arjun *": "allow",
      "wafw00f *": "allow",
      "grpcurl *": "allow",
      "subfinder *": "allow",
      "interactsh-client *": "allow",
      "semgrep *": "allow",
      "dnsx *": "allow",
      "nmap *": "allow",
      "masscan *": "allow",
      "naabu *": "allow",
      "netexec *": "allow",
      "enum4linux *": "allow",
      "hydra *": "allow",
      "searchsploit *": "allow",
      "smbclient *": "allow",
      "dnsrecon *": "allow",
      "whatweb *": "allow",
      "nikto *": "allow",
      "openssl *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "sort *": "allow",
      "wc *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "base64 *": "allow",
      "echo *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "date *": "allow",
      "bash scripts/*": "allow",
      "bash artemis/scripts/*": "allow",
      "bash artemis/promptfoo/*": "allow",
      "bash huginn/scripts/*": "allow",
      "bash hunter/scripts/*": "allow",
      "bash nimbus/scripts/*": "allow",
      "bash nomad/scripts/*": "allow",
      "bash specter/scripts/*": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "tee *": "allow",
      "touch *": "allow",
      "uniq *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "tr *": "allow",
      "cut *": "allow",
      "diff *": "allow",
      "env": "allow",
      "which": "allow",
      "pwd": "allow",
      "id": "allow",
      "sleep *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "realpath *": "allow",
      "seq *": "allow",
      "tail -f *": "allow",
      "xargs *": "allow",
      "tree *": "allow",
      "du *": "allow",
      "df *": "allow",
      "tar *": "allow",
      "unzip *": "allow",
      "zip *": "allow",
      "ln *": "allow",
      "chmod +x *": "allow",
      "rm -rf /*": "deny",
      "rm -fr /*": "deny",
      "rm -rf ~*": "deny",
      "sudo rm*": "deny",
      "sudo *": "deny",
      "git push*": "deny",
      "git * push*": "deny",
      "git stash*": "deny",
      "git * stash*": "deny"
    }
  },
  "mcp": {
    "servers": {
      "ghost-security": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@anthropic/ghost-security-mcp"
        ],
        "environment": {
          "GHOST_API_KEY": "{env:GHOST_API_KEY}"
        },
        "disabled": true
      }
    }
  }
}
